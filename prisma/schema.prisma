datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum EditionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  EDITOR
  REGISTRATION_MANAGER
  MEDIA_MANAGER
  VIEWER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum QueryStatus {
  PENDING
  REPLIED
  ARCHIVED
}

// -------------------------------------------------------------
// 1. CONFERENCE EDITIONS
// -------------------------------------------------------------
model ConferenceEdition {
  id              String        @id @default(cuid())
  year            String        @unique // e.g. "2026", "2027"
  title           String        // e.g. "AIPC 2026"
  slug            String        @unique // e.g. "2026"
  status          EditionStatus @default(DRAFT)
  isActivePublic  Boolean       @default(false)
  
  // Theme & Identity
  themeTitle      String        // e.g. "Living as Exiles"
  themeSubtitle   String?       // e.g. "Expositions in 1 Peter"
  themeScripture  String?       @db.Text
  themeReference  String?       // e.g. "1 Peter 1:24-25"
  themeSummary    String?       @db.Text
  themeTags       String[]
  
  // Dates & Venue
  startDate       DateTime
  endDate         DateTime
  datesDisplay    String        // e.g. "Sep 29 – Oct 1, 2026"
  venueName       String        // e.g. "GCC Hotel & Club"
  venueCity       String        // e.g. "Mumbai"
  venueState      String?       // e.g. "Maharashtra"
  venueAddress    String        @db.Text
  venueMapUrl     String?
  targetCountdown DateTime
  
  // Hero & Brand Customization
  heroPreTitle    String?
  heroTagline     String?
  heroBgImageUrl  String?
  heroVideoUrl    String?
  
  // About & Metric Statistics
  aboutPreTitle   String?
  aboutHeading    String?
  aboutP1         String?       @db.Text
  aboutP2         String?       @db.Text
  aboutStats      Json?
  aboutSlides     String[]
  
  // SEO & Metadata
  seoTitle        String?
  seoDescription  String?
  seoOgImageUrl   String?
  canonicalUrl    String?
  
  // Relations
  sections        EditionSection[]
  speakers        SpeakerAssignment[]
  scheduleDays    ProgrammeDay[]
  packages        AccommodationPackage[]
  partners        PartnerMinistry[]
  albums          GalleryAlbum[]
  faqs            FaqItem[]
  announcements   Announcement[]
  registrations   Registration[]
  queries         ContactQuery[]
  revisions       ContentRevision[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// -------------------------------------------------------------
// 2. HOMEPAGE BUILDER & SECTION LAYOUTS
// -------------------------------------------------------------
model EditionSection {
  id              String            @id @default(cuid())
  editionId       String
  edition         ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sectionKey      String
  displayName     String
  sortOrder       Int               @default(0)
  isEnabled       Boolean           @default(true)
  showInNav       Boolean           @default(true)
  navLabel        String?
  customTitle     String?
  customSubtitle  String?
  layoutVariant   String            @default("default")
  desktopVisible  Boolean           @default(true)
  mobileVisible   Boolean           @default(true)
  configJson      Json?
  
  @@unique([editionId, sectionKey])
}

// -------------------------------------------------------------
// 3. SPEAKERS & KEYNOTES
// -------------------------------------------------------------
model Speaker {
  id          String              @id @default(cuid())
  name        String
  title       String
  church      String
  city        String
  bio         String?             @db.Text
  photoUrl    String?
  websiteUrl  String?
  socialLinks Json?
  assignments SpeakerAssignment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model SpeakerAssignment {
  id         String            @id @default(cuid())
  editionId  String
  edition    ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  speakerId  String
  speaker    Speaker           @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  isKeynote  Boolean           @default(false)
  sortOrder  Int               @default(0)
  topicTitle String?
  sessions   ProgrammeSession[]

  @@unique([editionId, speakerId])
}

// -------------------------------------------------------------
// 4. PROGRAMME & SCHEDULE
// -------------------------------------------------------------
model ProgrammeDay {
  id          String             @id @default(cuid())
  editionId   String
  edition     ConferenceEdition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  dayNumber   Int
  date        DateTime
  dateDisplay String
  dayLabel    String
  sessions    ProgrammeSession[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ProgrammeSession {
  id                  String             @id @default(cuid())
  dayId               String
  day                 ProgrammeDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  sessionCode         String?
  title               String
  description         String?            @db.Text
  startTime           String
  endTime             String
  sessionType         String
  location            String?
  speakerAssignmentId String?
  speakerAssignment   SpeakerAssignment? @relation(fields: [speakerAssignmentId], references: [id], onDelete: SetNull)
  sortOrder           Int                @default(0)
  isEnabled           Boolean            @default(true)
}

// -------------------------------------------------------------
// 5. ACCOMMODATION & PRICING PACKAGES
// -------------------------------------------------------------
model AccommodationPackage {
  id            String            @id @default(cuid())
  editionId     String
  edition       ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  packageKey    String
  title         String
  occupancy     String
  guestCount    Int               @default(3)
  priceAmount   Decimal           @db.Decimal(10, 2)
  currency      String            @default("INR")
  badgeText     String?
  isFeatured    Boolean           @default(false)
  features      String[]
  totalCapacity Int?
  sortOrder     Int               @default(0)
  isEnabled     Boolean           @default(true)
  registrations Registration[]
}

// -------------------------------------------------------------
// 6. ORGANISERS & PARTNER MINISTRIES
// -------------------------------------------------------------
model PartnerMinistry {
  id          String            @id @default(cuid())
  editionId   String
  edition     ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name        String
  logoUrl     String
  description String            @db.Text
  websiteUrl  String
  isPrimary   Boolean           @default(false)
  sortOrder   Int               @default(0)
}

// -------------------------------------------------------------
// 7. PHOTO & VIDEO GALLERIES
// -------------------------------------------------------------
model GalleryAlbum {
  id        String            @id @default(cuid())
  editionId String
  edition   ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int               @default(0)
  photos    GalleryPhoto[]
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photoUrl  String
  altText   String?
  caption   String?
  gridSlot  String?
  sortOrder Int          @default(0)
}

// -------------------------------------------------------------
// 8. FAQS & ANNOUNCEMENTS
// -------------------------------------------------------------
model FaqItem {
  id           String            @id @default(cuid())
  editionId    String
  edition      ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  question     String
  answerHtml   String            @db.Text
  columnNumber Int               @default(1)
  sortOrder    Int               @default(0)
  isEnabled    Boolean           @default(true)
}

model Announcement {
  id          String            @id @default(cuid())
  editionId   String
  edition     ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  title       String
  content     String            @db.Text
  badgeText   String?
  imageUrl    String?
  actionUrl   String?
  actionLabel String?
  isPublished Boolean           @default(false)
  publishAt   DateTime?
  expiresAt   DateTime?
  sortOrder   Int               @default(0)
}

// -------------------------------------------------------------
// 9. REGISTRATIONS & ATTENDEE CRM
// -------------------------------------------------------------
model Registration {
  id               String               @id @default(cuid())
  editionId        String
  edition          ConferenceEdition    @relation(fields: [editionId], references: [id], onDelete: Restrict)
  regCode          String               @unique
  firstName        String
  lastName         String
  email            String
  phone            String
  age              String?
  gender           String               @default("Male")
  church           String
  designation      String
  street           String?
  city             String
  state            String
  country          String               @default("India")
  zip              String?
  packageId        String?
  package          AccommodationPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  planTitle        String
  amount           Decimal              @db.Decimal(10, 2)
  paymentStatus    PaymentStatus        @default(PENDING)
  paymentReference String?
  notes            String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([editionId, paymentStatus])
  @@index([email])
}

// -------------------------------------------------------------
// 10. CONTACT ENQUIRIES
// -------------------------------------------------------------
model ContactQuery {
  id         String            @id @default(cuid())
  editionId  String?
  edition    ConferenceEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  queryCode  String            @unique
  name       String
  email      String
  phone      String?
  message    String            @db.Text
  status     QueryStatus       @default(PENDING)
  replyNotes String?           @db.Text
  repliedAt  DateTime?
  repliedBy  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

// -------------------------------------------------------------
// 11. SECURITY, ADMIN USERS & AUDIT LOGS
// -------------------------------------------------------------
model AdminUser {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         UserRole          @default(EDITOR)
  isActive     Boolean           @default(true)
  lastLoginAt  DateTime?
  logs         ActivityLog[]
  revisions    ContentRevision[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ActivityLog {
  id         String     @id @default(cuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())
}

model ContentRevision {
  id          String            @id @default(cuid())
  editionId   String
  edition     ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  authorId    String?
  author      AdminUser?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  snapshot    Json
  summary     String?
  createdAt   DateTime          @default(now())
}

// -------------------------------------------------------------
// 12. MEDIA LIBRARY METADATA
// -------------------------------------------------------------
model MediaAsset {
  id         String   @id @default(cuid())
  filename   String
  blobUrl    String   @unique
  folder     String   @default("general")
  mimeType   String
  sizeBytes  Int
  altText    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
}
